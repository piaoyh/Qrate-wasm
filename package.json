{
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "wasm-pack": "^0.15.1"
  },
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir ../Extension/src/pkg && [[ -d ../Extension/dist/pkg ]] || mkdir -p ../Extension/dist/pkg && cp -r ../Extension/src/pkg/*.js ../Extension/src/pkg/*.wasm ../Extension/dist/pkg/"
  }
}
